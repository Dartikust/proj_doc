# Local server (python app.py / python site.py)
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=false

# Leave blank to reuse/generate instance/secret.key
SECRET_KEY=

# Relative paths are resolved from the project directory
DATABASE=instance/contracts.sqlite3
UPLOAD_FOLDER=instance/uploads
MAX_UPLOAD_MB=10

# Semantic search and document list
SEARCH_MODEL_DIR=instance/models
SEARCH_MIN_SCORE=0.3
DOCUMENTS_PAGE_SIZE=25
